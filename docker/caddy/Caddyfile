# ── Local development (HTTP only, no TLS) ─────────────────────────────────────
:80 {
    # Next.js web app
    handle /api/* {
        reverse_proxy api:8080
    }
    handle /health/* {
        reverse_proxy api:8080
    }
    handle /hangfire/* {
        reverse_proxy api:8080
    }
    handle {
        reverse_proxy web:3000
    }
}

# ── Production template (replace :80 block with this) ─────────────────────────
# {$DOMAIN} {
#     reverse_proxy /api/* api:8080
#     reverse_proxy /health/* api:8080
#     reverse_proxy /hangfire/* api:8080
#     reverse_proxy * web:3000
# }
