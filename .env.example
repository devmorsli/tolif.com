# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tolif
POSTGRES_USER=tolif
POSTGRES_PASSWORD=change_me_postgres

# ─── MinIO / S3 ───────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=tolif
# For production (Cloudflare R2 or AWS S3):
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=tolif
# S3_REGION=auto

# ─── ASP.NET Core API ─────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
# Data Protection key ring path (for encrypted Settings values)
DATA_PROTECTION_KEYS_PATH=/app/dataprotection-keys

# ─── Admin seed user (created on first run) ───────────────────────────────────
ADMIN_EMAIL=admin@tolif.com
ADMIN_PASSWORD=Admin@12345!

# ─── JWT / Cookie auth ────────────────────────────────────────────────────────
JWT_SECRET=change_me_jwt_secret_min_32_chars_long

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── AI Providers (also editable in Admin → Settings) ────────────────────────
# Google Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-preview-image-generation
# Google Vertex AI (alternative to API key)
VERTEX_PROJECT_ID=
VERTEX_REGION=us-central1
VERTEX_SERVICE_ACCOUNT_JSON=

# fal.ai
FAL_API_KEY=

# OpenAI
OPENAI_API_KEY=

# ─── Print Providers (also editable in Admin → Settings) ─────────────────────
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=
PRINTFUL_WEBHOOK_SECRET=

PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=
PRINTIFY_WEBHOOK_SECRET=

# ─── Email (also editable in Admin → Settings) ────────────────────────────────
# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Tolif
SMTP_FROM_EMAIL=noreply@tolif.com
# Or Resend
RESEND_API_KEY=

# ─── Localisation ─────────────────────────────────────────────────────────────
# IP geolocation API for auto-detecting customer currency & language
IPAPI_KEY=

# ─── Cloudflare Turnstile (abuse protection on preview generation) ────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Next.js public vars ──────────────────────────────────────────────────────
# Local: http://localhost:5000  |  Production: https://yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─── Caddy + CORS (production only) ───────────────────────────────────────────
DOMAIN=tolif.com
ALLOWED_ORIGINS=https://tolif.com
